{
    "name": "campaign-api",
    "private": true,
    "version": "0.1.0",
    "description": "Campaign API Lambda handlers (Issue #5). Node 20.x runtime, bundled with esbuild at deploy time.",
    "engines": {
        "node": ">=20"
    },
    "imports": {
        "#config/*": "./src/config/*.ts",
        "#controllers/*": "./src/controllers/*.ts",
        "#db/*": "./src/db/*.ts",
        "#handlers/*": "./src/handlers/*.ts",
        "#http/*": "./src/http/*.ts",
        "#repositories/*": "./src/repositories/*.ts",
        "#schemas/*": "./src/schemas/*.ts",
        "#services/*": "./src/services/*.ts",
        "#utils/*": "./src/utils/*.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:coverage": "jest --coverage"
    },
    "dependencies": {
        "@aws-sdk/rds-signer": "^3.1170.0",
        "pg": "^8.13.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.145",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.1",
        "@types/pg": "^8.11.10",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "typescript": "^5.7.2"
    }
}
