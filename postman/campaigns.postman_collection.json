{
    "info": {
        "name": "Campaign API — Issue #5",
        "description": "Smoke tests for the Campaign API Lambda handlers. Set {{baseUrl}} to the local sam/serverless-offline endpoint or the deployed API Gateway stage URL, and paste a Cognito ID token into {{cognitoIdToken}}. Template/segment UUIDs below are seed values from db/seed.sql.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:3000" },
        { "key": "cognitoIdToken", "value": "<paste-cognito-id-token>" },
        { "key": "templateId", "value": "22222222-2222-4000-8000-000000000001" },
        { "key": "segmentId", "value": "11111111-1111-4000-8000-000000000001" }
    ],
    "item": [
        {
            "name": "POST /campaigns",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{cognitoIdToken}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/campaigns",
                    "host": ["{{baseUrl}}"],
                    "path": ["campaigns"]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Black Friday Early Access\",\n  \"templateId\": \"{{templateId}}\",\n  \"segmentId\": \"{{segmentId}}\"\n}",
                    "options": { "raw": { "language": "json" } }
                },
                "description": "Creates a campaign in draft (US01). Happy path + the 4xx cases from docs/api-contract.md §2.1."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 201 Created on happy path', () => {",
                            "  if (pm.response.code === 400 && pm.response.json().error.code === 'VALIDATION_ERROR') return;",
                            "  pm.expect(pm.response.code).to.eql(201);",
                            "});",
                            "pm.test('created campaign is draft and has camelCase fields', () => {",
                            "  const b = pm.response.json();",
                            "  pm.expect(b.status).to.eql('draft');",
                            "  pm.expect(b.campaignId).to.be.a('string');",
                            "  pm.expect(b.templateId).to.eql(pm.collectionVariables.get('templateId'));",
                            "});",
                            "pm.test('4xx responses use the standard error envelope', () => {",
                            "  if (pm.response.code >= 400) pm.expect(pm.response.json().error).to.have.property('code');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "POST /campaigns — 400 invalid body",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{cognitoIdToken}}" }
                ],
                "url": { "raw": "{{baseUrl}}/campaigns", "host": ["{{baseUrl}}"], "path": ["campaigns"] },
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"\",\n  \"templateId\": \"not-a-uuid\",\n  \"segmentId\": \"not-a-uuid\"\n}",
                    "options": { "raw": { "language": "json" } }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('400 VALIDATION_ERROR', () => {",
                            "  pm.expect(pm.response.code).to.eql(400);",
                            "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "POST /campaigns — 404 unknown template",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{cognitoIdToken}}" }
                ],
                "url": { "raw": "{{baseUrl}}/campaigns", "host": ["{{baseUrl}}"], "path": ["campaigns"] },
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Ghost template campaign\",\n  \"templateId\": \"00000000-0000-4000-8000-000000000000\",\n  \"segmentId\": \"{{segmentId}}\"\n}",
                    "options": { "raw": { "language": "json" } }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('404 RESOURCE_NOT_FOUND', () => {",
                            "  pm.expect(pm.response.code).to.eql(404);",
                            "  pm.expect(pm.response.json().error.code).to.eql('RESOURCE_NOT_FOUND');",
                            "  pm.expect(pm.response.json().error.details.field).to.eql('templateId');",
                            "});"
                        ]
                    }
                }
            ]
        }
    ]
}
