{
    "info": {
        "name": "Campaign API — Issue #32 (campaign endpoints)",
        "description": "Smoke tests for the remaining /campaigns routes (issue #32, endpoint group 1/3). Set {{baseUrl}} to the local endpoint or the deployed API Gateway stage URL, paste a Cognito ID token into {{cognitoIdToken}}, and point {{campaignId}} at a draft campaign (the db/seed.sql draft is 33333333-3333-4000-8000-000000000003). Run DELETE last — it removes that draft.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000"
        },
        {
            "key": "cognitoIdToken",
            "value": "<paste-cognito-id-token>"
        },
        {
            "key": "campaignId",
            "value": "33333333-3333-4000-8000-000000000003"
        },
        {
            "key": "scheduledAt",
            "value": "2030-01-01T09:00:00Z"
        }
    ],
    "item": [
        {
            "name": "GET /campaigns — page 1",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{cognitoIdToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/campaigns?page=1&limit=20",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "campaigns"
                    ],
                    "query": [
                        {
                            "key": "page",
                            "value": "1"
                        },
                        {
                            "key": "limit",
                            "value": "20"
                        }
                    ]
                },
                "description": "Lists campaigns with the contract's pagination block (US01/US04)."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('data is an array and pagination is present', () => {",
                            "  const b = pm.response.json();",
                            "  pm.expect(b.data).to.be.an('array');",
                            "  pm.expect(b.pagination).to.have.all.keys('currentPage', 'totalPages', 'totalItems');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "GET /campaigns — 400 unknown status",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{cognitoIdToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/campaigns?status=paused",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "campaigns"
                    ],
                    "query": [
                        {
                            "key": "status",
                            "value": "paused"
                        }
                    ]
                },
                "description": "The status filter accepts only the six state-machine values."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 400 with VALIDATION_ERROR', () => {",
                            "  pm.expect(pm.response.code).to.eql(400);",
                            "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                            "  pm.expect(pm.response.json().error.details.field).to.eql('status');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "GET /campaigns/{id}",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{cognitoIdToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/campaigns/{{campaignId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "campaigns",
                        "{{campaignId}}"
                    ]
                },
                "description": "Campaign detail with template and segment summaries."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('body carries the summaries', () => {",
                            "  const b = pm.response.json();",
                            "  pm.expect(b.template).to.have.property('name');",
                            "  pm.expect(b.segment).to.have.property('name');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "PUT /campaigns/{id}",
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{cognitoIdToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/campaigns/{{campaignId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "campaigns",
                        "{{campaignId}}"
                    ]
                },
                "description": "Draft-only partial update; a non-draft campaign answers 409.",
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Black Friday Early Access (edited)\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200 or 409 conflict', () => {",
                            "  pm.expect([200, 409]).to.include(pm.response.code);",
                            "});",
                            "pm.test('4xx uses the standard error envelope', () => {",
                            "  if (pm.response.code === 409) pm.expect(pm.response.json().error.code).to.eql('CONFLICT');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "POST /campaigns/{id}/schedule",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{cognitoIdToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/campaigns/{{campaignId}}/schedule",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "campaigns",
                        "{{campaignId}}",
                        "schedule"
                    ]
                },
                "description": "Draft -> scheduled; scheduledAt must be at least 5 minutes ahead.",
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"scheduledAt\": \"{{scheduledAt}}\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200 or 409 conflict', () => {",
                            "  pm.expect([200, 409]).to.include(pm.response.code);",
                            "});",
                            "pm.test('scheduled campaign carries the timestamp', () => {",
                            "  if (pm.response.code === 200) {",
                            "    const b = pm.response.json();",
                            "    pm.expect(b.status).to.eql('scheduled');",
                            "    pm.expect(b.dispatchMode).to.eql('scheduled');",
                            "    pm.expect(b.scheduledAt).to.be.a('string');",
                            "  }",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "POST /campaigns/{id}/send",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{cognitoIdToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/campaigns/{{campaignId}}/send",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "campaigns",
                        "{{campaignId}}",
                        "send"
                    ]
                },
                "description": "Immediate dispatch: draft -> sending, dispatchMode=immediate, no scheduled state."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200 or 409 conflict', () => {",
                            "  pm.expect([200, 409]).to.include(pm.response.code);",
                            "});",
                            "pm.test('immediate dispatch skips scheduled', () => {",
                            "  if (pm.response.code === 200) {",
                            "    const b = pm.response.json();",
                            "    pm.expect(b.status).to.eql('sending');",
                            "    pm.expect(b.dispatchMode).to.eql('immediate');",
                            "  }",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "POST /campaigns/{id}/cancel",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{cognitoIdToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/campaigns/{{campaignId}}/cancel",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "campaigns",
                        "{{campaignId}}",
                        "cancel"
                    ]
                },
                "description": "Scheduled -> cancelled, only before the execution timestamp."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200 or 409 conflict', () => {",
                            "  pm.expect([200, 409]).to.include(pm.response.code);",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "GET /campaigns/{id}/logs",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{cognitoIdToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/campaigns/{{campaignId}}/logs",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "campaigns",
                        "{{campaignId}}",
                        "logs"
                    ]
                },
                "description": "Dispatch log for the campaign (US04)."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200 or 404 for a missing campaign', () => {",
                            "  pm.expect([200, 404]).to.include(pm.response.code);",
                            "});",
                            "pm.test('logs array matches the campaign', () => {",
                            "  if (pm.response.code === 200) {",
                            "    const b = pm.response.json();",
                            "    pm.expect(b.campaignId).to.eql(pm.collectionVariables.get('campaignId'));",
                            "    pm.expect(b.logs).to.be.an('array');",
                            "  }",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "DELETE /campaigns/{id}",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{cognitoIdToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/campaigns/{{campaignId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "campaigns",
                        "{{campaignId}}"
                    ]
                },
                "description": "Draft-only delete, 204 with no body. Run last: it removes the draft seed campaign."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 204 or 409 conflict', () => {",
                            "  pm.expect([204, 409]).to.include(pm.response.code);",
                            "});"
                        ]
                    }
                }
            ]
        }
    ]
}
